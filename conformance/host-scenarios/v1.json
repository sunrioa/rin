{
  "schema_version": 1,
  "contract": "rin.host-scenarios/v1",
  "scenarios": [
    {
      "id": "stale_epoch_rejection",
      "requirement": "An offer or invocation from a replaced Host, World, or Timeline epoch cannot execute.",
      "evidence": [
        "sdk/hostkit/coordinator_test.go",
        "examples/native-host/tests/test_rin_host.c",
        "examples/mods/fabric-rin-npc/src/test/java/io/github/sunrioa/rin/example/RinFabricStateTest.java",
        "examples/mods/luanti-rin-npc/test_state.lua",
        "tools/unity-harness/Program.cs",
        "examples/godot/tests/test_workflow.gd"
      ]
    },
    {
      "id": "idempotent_operation",
      "requirement": "A repeated stable Operation ID cannot repeat its game effect.",
      "evidence": [
        "sdk/hostkit/coordinator_test.go",
        "examples/native-host/tests/test_rin_host.c"
      ]
    },
    {
      "id": "revoked_capability_rejection",
      "requirement": "Dynamic capability revocation invalidates an older offer before execution.",
      "evidence": [
        "sdk/hostkit/coordinator_test.go",
        "examples/native-host/tests/test_rin_host.c"
      ]
    },
    {
      "id": "exact_outbox_retry",
      "requirement": "A failed report retains the exact payload and stable identities for retry.",
      "evidence": [
        "sdk/hostkit/coordinator_test.go"
      ]
    },
    {
      "id": "long_action_epoch_cancel",
      "requirement": "An active long-running action is cancelled or becomes outcome-unknown when its epoch is replaced.",
      "evidence": [
        "sdk/hostkit/coordinator_test.go",
        "examples/mods/luanti-rin-npc/test_state.lua",
        "tools/unity-harness/Program.cs",
        "examples/godot/tests/test_workflow.gd"
      ]
    },
    {
      "id": "simultaneous_window_atomicity",
      "requirement": "A simultaneous Decision Window collects one legal action per actor and applies the joint action without inventing a turn order.",
      "evidence": [
        "tools/verify_open_spiel.py"
      ]
    },
    {
      "id": "chance_transition_host_owned",
      "requirement": "A chance transition is resolved by the game and cannot become a model-selectable Action Offer.",
      "evidence": [
        "tools/verify_open_spiel.py"
      ]
    },
    {
      "id": "private_observation_noninterference",
      "requirement": "Two hidden worlds indistinguishable to an actor produce the same actor Observation and legal Offers.",
      "evidence": [
        "tools/verify_open_spiel.py"
      ]
    }
  ]
}
