{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Rin Management API",
    "version": "1.0.0",
    "description": "Local, bearer-authenticated management contract for Rin Console. It exposes configuration, memory, persona, Skill, task and execution management without exposing prompts, private memory or credentials."
  },
  "servers": [{"url": "http://127.0.0.1:7375"}],
  "security": [{"bearerAuth": []}],
  "x-rin-contract-version": "rin.management/v1",
  "paths": {
    "/management/v1/info": {
      "get": {
        "operationId": "management_v1_info",
        "responses": {"200": {"description": "Management capabilities", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InfoResponse"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/personas": {
      "get": {
        "operationId": "management_v1_get_personas",
        "responses": {"200": {"description": "Persona snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PersonaSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      },
      "put": {
        "operationId": "management_v1_replace_personas",
        "requestBody": {"$ref": "#/components/requestBodies/PersonaSnapshot"},
        "responses": {"200": {"description": "Updated persona snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PersonaSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/memories/list": {
      "post": {
        "operationId": "management_v1_list_memories",
        "requestBody": {"$ref": "#/components/requestBodies/MemoryListRequest"},
        "responses": {"200": {"description": "Common memory cards", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryListResponse"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/memories/save": {
      "post": {
        "operationId": "management_v1_save_memory",
        "requestBody": {"$ref": "#/components/requestBodies/MemoryCardInput"},
        "responses": {"200": {"description": "Created or superseding memory card", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryCard"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/memories/forget": {
      "post": {
        "operationId": "management_v1_forget_memory",
        "requestBody": {"$ref": "#/components/requestBodies/MemoryForgetInput"},
        "responses": {"200": {"description": "Forget result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForgottenResponse"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/tasks/list": {
      "post": {
        "operationId": "management_v1_list_tasks",
        "requestBody": {"$ref": "#/components/requestBodies/TaskListInput"},
        "responses": {"200": {"description": "Long-goal task list", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskListOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/tasks/start": {
      "post": {
        "operationId": "management_v1_start_task",
        "requestBody": {"$ref": "#/components/requestBodies/TaskStartInput"},
        "responses": {"200": {"description": "Created task", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskSummary"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/tasks/get": {
      "post": {
        "operationId": "management_v1_get_task",
        "requestBody": {"$ref": "#/components/requestBodies/TaskGetInput"},
        "responses": {"200": {"description": "Task and public timeline", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskDetail"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/tasks/control": {
      "post": {
        "operationId": "management_v1_control_task",
        "requestBody": {"$ref": "#/components/requestBodies/TaskControlInput"},
        "responses": {"200": {"description": "Updated task", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskSummary"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/list": {
      "post": {
        "operationId": "management_v1_list_skills",
        "requestBody": {"$ref": "#/components/requestBodies/SkillListInput"},
        "responses": {"200": {"description": "Skill summaries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillListOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/get": {
      "post": {
        "operationId": "management_v1_get_skill",
        "requestBody": {"$ref": "#/components/requestBodies/SkillGetInput"},
        "responses": {"200": {"description": "Skill document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillGetOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/save": {
      "post": {
        "operationId": "management_v1_save_skill",
        "requestBody": {"$ref": "#/components/requestBodies/SkillSaveInput"},
        "responses": {"200": {"description": "Saved learned Skill", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillGetOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/reload": {
      "post": {
        "operationId": "management_v1_reload_skills",
        "requestBody": {"$ref": "#/components/requestBodies/EmptyObject"},
        "responses": {"200": {"description": "Reload result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillReloadOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/import": {
      "post": {
        "operationId": "management_v1_import_skill",
        "requestBody": {"$ref": "#/components/requestBodies/SkillImportInput"},
        "responses": {"200": {"description": "Imported learned Skill", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillGetOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/skills/remove": {
      "post": {
        "operationId": "management_v1_remove_skill",
        "requestBody": {"$ref": "#/components/requestBodies/SkillRemoveInput"},
        "responses": {"200": {"description": "Removed learned Skill and reloaded catalog", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillReloadOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/runtime": {
      "get": {
        "operationId": "management_v1_runtime",
        "responses": {"200": {"description": "Visible Hosts, worlds and actors", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuntimeSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/diagnostics": {
      "get": {
        "operationId": "management_v1_diagnostics",
        "responses": {"200": {"description": "Metadata-only diagnostics", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticsSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/agent/config": {
      "get": {
        "operationId": "management_v1_get_agent_config",
        "responses": {"200": {"description": "Agent configuration without secrets", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConfigSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      },
      "put": {
        "operationId": "management_v1_save_agent_config",
        "requestBody": {"$ref": "#/components/requestBodies/AgentConfigSaveRequest"},
        "responses": {"200": {"description": "Saved Agent configuration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConfigSaveResponse"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/policy/config": {
      "get": {
        "operationId": "management_v1_get_policy_config",
        "responses": {"200": {"description": "Gameplay policy configuration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicyConfigSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      },
      "put": {
        "operationId": "management_v1_save_policy_config",
        "requestBody": {"$ref": "#/components/requestBodies/PolicyConfigSaveRequest"},
        "responses": {"200": {"description": "Saved gameplay policy configuration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicyConfigSnapshot"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/operations/list": {
      "post": {
        "operationId": "management_v1_list_operations",
        "requestBody": {"$ref": "#/components/requestBodies/OperationListInput"},
        "responses": {"200": {"description": "Principal-visible operation history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationListOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/operations/control": {
      "post": {
        "operationId": "management_v1_control_operation",
        "requestBody": {"$ref": "#/components/requestBodies/OperationControlInput"},
        "responses": {"200": {"description": "Updated operation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationView"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/management/v1/actors/control": {
      "post": {
        "operationId": "management_v1_control_actor",
        "requestBody": {"$ref": "#/components/requestBodies/ActorControlInput"},
        "responses": {"200": {"description": "Updated controller lease or emergency stop", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActorControlOutput"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "requestBodies": {
      "EmptyObject": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptyObject"}}}},
      "PersonaSnapshot": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PersonaSnapshot"}}}},
      "MemoryListRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryListRequest"}}}},
      "MemoryCardInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryCardInput"}}}},
      "MemoryForgetInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoryForgetInput"}}}},
      "TaskListInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskListInput"}}}},
      "TaskStartInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskStartInput"}}}},
      "TaskGetInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskGetInput"}}}},
      "TaskControlInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskControlInput"}}}},
      "SkillListInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillListInput"}}}},
      "SkillGetInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillGetInput"}}}},
      "SkillSaveInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillSaveInput"}}}},
      "SkillImportInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillImportInput"}}}},
      "SkillRemoveInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SkillRemoveInput"}}}},
      "AgentConfigSaveRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConfigSaveRequest"}}}},
      "PolicyConfigSaveRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PolicyConfigSaveRequest"}}}},
      "OperationListInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationListInput"}}}},
      "OperationControlInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationControlInput"}}}},
      "ActorControlInput": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActorControlInput"}}}}
    },
    "responses": {
      "Error": {"description": "Management API error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    },
    "schemas": {
      "Identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
      "UnsignedInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
      "PositiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
      "Text": {"type": "string", "minLength": 1, "maxLength": 8192},
      "JSONValue": {},
      "JSONObject": {"type": "object", "additionalProperties": true},
      "EmptyObject": {"type": "object", "additionalProperties": false},
      "ErrorResponse": {"type": "object", "additionalProperties": false, "properties": {"error": {"type": "object", "additionalProperties": false, "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 8192}}, "required": ["message"]}}, "required": ["error"]},
      "InfoResponse": {"type": "object", "additionalProperties": false, "properties": {"contract_version": {"const": "rin.management/v1"}, "features": {"type": "array", "items": {"type": "string"}, "maxItems": 32}}, "required": ["contract_version", "features"]},
      "Timepoint": {"type": "object", "additionalProperties": false, "properties": {"clock": {"type": "string", "enum": ["event", "step", "realtime"]}, "value": {"type": "integer"}}, "required": ["clock", "value"]},
      "Epoch": {"type": "object", "additionalProperties": false, "properties": {"session_id": {"$ref": "#/components/schemas/Identifier"}, "world_id": {"$ref": "#/components/schemas/Identifier"}, "host": {"$ref": "#/components/schemas/UnsignedInteger"}, "world": {"$ref": "#/components/schemas/UnsignedInteger"}, "timeline": {"$ref": "#/components/schemas/UnsignedInteger"}}, "required": ["session_id", "world_id", "host", "world", "timeline"]},
      "PersonaBoundary": {"type": "object", "additionalProperties": false, "properties": {"boundary_id": {"$ref": "#/components/schemas/Identifier"}, "rule": {"$ref": "#/components/schemas/Text"}, "response": {"$ref": "#/components/schemas/Text"}}, "required": ["boundary_id", "rule", "response"]},
      "RelationshipStance": {"type": "object", "additionalProperties": false, "properties": {"role": {"$ref": "#/components/schemas/Text"}, "stance": {"$ref": "#/components/schemas/Text"}}, "required": ["role", "stance"]},
      "InitiativePolicy": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "cooldown_millis": {"type": "integer", "minimum": 0}, "max_consecutive_actions": {"type": "integer", "minimum": 0}, "triggers": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Identifier"}}}, "required": ["enabled", "cooldown_millis", "max_consecutive_actions"]},
      "PersonaProfile": {"type": "object", "additionalProperties": false, "properties": {"persona_id": {"$ref": "#/components/schemas/Identifier"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "identity": {"$ref": "#/components/schemas/Text"}, "traits": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Text"}}, "values": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Text"}}, "voice": {"type": "string", "maxLength": 8192}, "boundaries": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/PersonaBoundary"}}, "relationship_stances": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/RelationshipStance"}}, "initiative_policy": {"$ref": "#/components/schemas/InitiativePolicy"}, "presentation_rules": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Text"}}}, "required": ["persona_id", "version", "identity", "initiative_policy"]},
      "PersonaBinding": {"type": "object", "additionalProperties": false, "properties": {"actor_id": {"type": "string", "maxLength": 128}, "controller_id": {"type": "string", "maxLength": 128}, "persona_id": {"$ref": "#/components/schemas/Identifier"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["actor_id", "persona_id", "version"]},
      "PersonaSnapshot": {"type": "object", "additionalProperties": false, "properties": {"revision": {"$ref": "#/components/schemas/PositiveInteger"}, "profiles": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/components/schemas/PersonaProfile"}}, "bindings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/PersonaBinding"}}}, "required": ["revision", "profiles", "bindings"]},
      "MemoryListRequest": {"type": "object", "additionalProperties": false, "properties": {"scope": {"const": "common"}, "search": {"type": "string", "maxLength": 500}, "tags": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/Identifier"}}, "limit": {"type": "integer", "minimum": 0, "maximum": 500}}},
      "MemoryCardInput": {"type": "object", "additionalProperties": false, "properties": {"memory_id": {"$ref": "#/components/schemas/Identifier"}, "content": {"$ref": "#/components/schemas/Text"}, "tags": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Identifier"}}, "pinned": {"type": "boolean"}, "importance": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["content"]},
      "MemoryForgetInput": {"type": "object", "additionalProperties": false, "properties": {"memory_id": {"$ref": "#/components/schemas/Identifier"}, "reason": {"type": "string", "maxLength": 1000}}, "required": ["memory_id"]},
      "MemoryCard": {"type": "object", "additionalProperties": false, "properties": {"memory_id": {"$ref": "#/components/schemas/Identifier"}, "content": {"$ref": "#/components/schemas/Text"}, "tags": {"type": "array", "items": {"type": "string"}}, "pinned": {"type": "boolean"}, "importance": {"type": "number"}, "created_at": {"$ref": "#/components/schemas/Timepoint"}, "source": {"type": "string", "maxLength": 128}}, "required": ["memory_id", "content", "importance", "created_at", "source"]},
      "MemoryListResponse": {"type": "object", "additionalProperties": false, "properties": {"revision": {"$ref": "#/components/schemas/UnsignedInteger"}, "records": {"type": "array", "maxItems": 500, "items": {"$ref": "#/components/schemas/MemoryCard"}}}, "required": ["revision", "records"]},
      "ForgottenResponse": {"type": "object", "additionalProperties": false, "properties": {"forgotten": {"type": "boolean"}}, "required": ["forgotten"]},
      "TaskStatus": {"type": "string", "enum": ["active", "waiting-confirmation", "cancelling", "paused", "completed", "failed", "outcome-unknown", "cancelled"]},
      "PlanningMode": {"type": "string", "enum": ["auto", "required"]},
      "TaskListInput": {"type": "object", "additionalProperties": false, "properties": {"status": {"$ref": "#/components/schemas/TaskStatus"}, "limit": {"type": "integer", "minimum": 0, "maximum": 500}}},
      "TaskStartInput": {"type": "object", "additionalProperties": false, "properties": {"task_id": {"$ref": "#/components/schemas/Identifier"}, "host_id": {"$ref": "#/components/schemas/Identifier"}, "world_id": {"$ref": "#/components/schemas/Identifier"}, "actor_id": {"$ref": "#/components/schemas/Identifier"}, "goal": {"$ref": "#/components/schemas/Text"}, "planning_mode": {"$ref": "#/components/schemas/PlanningMode"}, "tags": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/Identifier"}}, "allowed_capabilities": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/Identifier"}}}, "required": ["host_id", "world_id", "actor_id", "goal"]},
      "TaskGetInput": {"type": "object", "additionalProperties": false, "properties": {"task_id": {"$ref": "#/components/schemas/Identifier"}}, "required": ["task_id"]},
      "TaskControlInput": {"type": "object", "additionalProperties": false, "properties": {"task_id": {"$ref": "#/components/schemas/Identifier"}, "action": {"type": "string", "enum": ["run", "resume", "cancel"]}}, "required": ["task_id", "action"]},
      "TaskSummary": {"type": "object", "additionalProperties": false, "properties": {"task_id": {"$ref": "#/components/schemas/Identifier"}, "host_id": {"$ref": "#/components/schemas/Identifier"}, "world_id": {"$ref": "#/components/schemas/Identifier"}, "actor_id": {"$ref": "#/components/schemas/Identifier"}, "goal": {"$ref": "#/components/schemas/Text"}, "tags": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/Identifier"}}, "status": {"$ref": "#/components/schemas/TaskStatus"}, "pause_code": {"type": "string", "maxLength": 128}, "planning_mode": {"$ref": "#/components/schemas/PlanningMode"}, "plan_id": {"type": "string", "maxLength": 128}, "plan_revision": {"$ref": "#/components/schemas/UnsignedInteger"}, "current_plan_step_id": {"type": "string", "maxLength": 128}, "step": {"type": "integer", "minimum": 0}, "max_steps": {"type": "integer", "minimum": 0}, "model_calls": {"type": "integer", "minimum": 0}, "model_tokens": {"$ref": "#/components/schemas/UnsignedInteger"}, "action_count": {"type": "integer", "minimum": 0}, "pending_operation_id": {"type": "string", "maxLength": 128}, "created_at_unix_millis": {"type": "integer"}, "updated_at_unix_millis": {"type": "integer"}}, "required": ["task_id", "host_id", "world_id", "actor_id", "goal", "status", "planning_mode", "step", "max_steps", "model_calls", "model_tokens", "action_count", "created_at_unix_millis", "updated_at_unix_millis"]},
      "TaskListOutput": {"type": "object", "additionalProperties": false, "properties": {"revision": {"$ref": "#/components/schemas/UnsignedInteger"}, "tasks": {"type": "array", "maxItems": 500, "items": {"$ref": "#/components/schemas/TaskSummary"}}}, "required": ["revision", "tasks"]},
      "TaskTimelineEvent": {"type": "object", "additionalProperties": true, "properties": {"sequence": {"$ref": "#/components/schemas/UnsignedInteger"}, "kind": {"type": "string", "maxLength": 128}, "step": {"type": "integer", "minimum": 0}, "summary": {"type": "string", "maxLength": 2000}, "operation_id": {"type": "string", "maxLength": 128}, "at_unix_millis": {"type": "integer"}}, "required": ["sequence", "kind", "step", "at_unix_millis"]},
      "TaskTimelinePage": {"type": "object", "additionalProperties": true, "properties": {"contract_version": {"type": "string"}, "task_id": {"$ref": "#/components/schemas/Identifier"}, "goal": {"type": "string", "maxLength": 8192}, "goal_digest": {"type": "string", "maxLength": 128}, "status": {"type": "string", "maxLength": 64}, "events": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/TaskTimelineEvent"}}, "next_cursor": {"type": "string", "maxLength": 256}, "more": {"type": "boolean"}, "truncated": {"type": "boolean"}}, "required": ["contract_version", "task_id", "events", "next_cursor", "more", "truncated"]},
      "TaskDetail": {"type": "object", "additionalProperties": false, "properties": {"task": {"$ref": "#/components/schemas/TaskSummary"}, "timeline": {"$ref": "#/components/schemas/TaskTimelinePage"}}, "required": ["task", "timeline"]},
      "SkillSummary": {"type": "object", "additionalProperties": false, "properties": {"skill_id": {"$ref": "#/components/schemas/Identifier"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "summary": {"type": "string", "maxLength": 2000}, "triggers": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}, "adapters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Identifier"}}, "capabilities": {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/Identifier"}}, "source": {"type": "string", "maxLength": 64}, "digest": {"type": "string", "maxLength": 128}}, "required": ["skill_id", "version", "summary", "source", "digest"]},
      "Skill": {"type": "object", "additionalProperties": false, "properties": {"skill_id": {"$ref": "#/components/schemas/Identifier"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "summary": {"type": "string", "maxLength": 2000}, "triggers": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}, "adapters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Identifier"}}, "capabilities": {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/Identifier"}}, "source": {"type": "string", "maxLength": 64}, "digest": {"type": "string", "maxLength": 128}, "instructions": {"type": "string", "minLength": 1, "maxLength": 65536}}, "required": ["skill_id", "version", "summary", "source", "digest", "instructions"]},
