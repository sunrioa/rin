{
  "version": 1,
  "request_body_limit": 1024,
  "slow_response_ms": 400,
  "create_session": {
    "protocol_version": "rin.protocol/v2",
    "request_id": "create.__client__",
    "session_id": "session.__client__",
    "binding": {
      "game_id": "conformance",
      "content_id": "sdk-corpus",
      "content_version": "1",
      "content_hash": "sha256:conformance"
    },
    "actors": [
      {
        "id": "npc.__client__",
        "kind": "npc",
        "display_name": "SDK Corpus NPC",
        "think_every_ticks": 1,
        "enabled": true
      }
    ]
  },
  "expectations": {
    "first_mutation": {
      "status": 200,
      "duplicate": false
    },
    "exact_retry": {
      "status": 200,
      "duplicate": true
    },
    "altered_retry": {
      "status": 409,
      "code": "request_id_conflict"
    },
    "unknown_field": {
      "status": 400,
      "code": "invalid_json"
    },
    "duplicate_member": {
      "status": 400,
      "code": "invalid_json"
    },
    "body_limit": {
      "status": 413,
      "code": "body_too_large"
    },
    "timeout": {
      "code": "transport_timeout"
    }
  }
}
